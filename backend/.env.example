# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cosechapp?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"

# App
PORT=3000
NODE_ENV=development

# FNC Scraping (optional - for price fetching)
FNC_PRICE_URL="https://www.federaciondecafeteros.org/precio-cafe"
FNC_SCRAPING_CRON="0 6 * * *"  # Daily at 6 AM

# FCM (for push notifications)
FCM_SERVER_KEY=""
FCM_PROJECT_ID=""

# Sync
SYNC_BATCH_SIZE=100
# Admin key for system endpoints (e.g. publishing the FNC coffee price). Header: x-admin-key
ADMIN_API_KEY="change-me-to-a-long-random-string"

# Gemini (precio FNC, noticias, análisis y tips en "Precio y Noticias"). Sin key, la IA queda apagada.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
# Si los datos tienen más de estas horas, se refrescan en segundo plano al leerlos.
COFFEE_INTEL_STALE_HOURS=24
