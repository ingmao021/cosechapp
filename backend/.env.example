# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cosechapp?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"

# App
PORT=3000
NODE_ENV=development

# Precio FNC: se lee de la página de la FNC (gratis). El refresh diario lo dispara GitHub Actions.
FNC_PRICE_URL="https://federaciondecafeteros.org/wp/"

# FCM (for push notifications)
FCM_SERVER_KEY=""
FCM_PROJECT_ID=""

# Sync
SYNC_BATCH_SIZE=100
# Admin key for system endpoints (e.g. publishing the FNC coffee price). Header: x-admin-key
ADMIN_API_KEY="change-me-to-a-long-random-string"

# Gemini, plan gratuito y sin búsqueda en Google: análisis del precio y elección de noticias.
# Sin key, el precio y las noticias igual se actualizan; solo no hay análisis.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
# Si los datos tienen más de estas horas, se refrescan en segundo plano al leerlos.
COFFEE_INTEL_STALE_HOURS=24
