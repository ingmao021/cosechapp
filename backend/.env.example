# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cosechapp?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"

# App
PORT=3000
NODE_ENV=development

# FNC Scraping (optional - for price fetching)
FNC_PRICE_URL="https://www.federaciondecafeteros.org/precio-cafe"
FNC_SCRAPING_CRON="0 6 * * *"  # Daily at 6 AM

# FCM (for push notifications)
FCM_SERVER_KEY=""
FCM_PROJECT_ID=""

# Sync
SYNC_BATCH_SIZE=100